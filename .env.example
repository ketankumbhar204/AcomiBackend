# Local-only example. Copy to .env if your tooling loads it, or export in the shell.
# .env is gitignored. Never put a real production secret in this file.

# Required when ACOMI_OTP_SENDER=twofactor (production profile always uses twofactor).
TWOFACTOR_API_KEY=<your-production-api-key>

# Optional. 2Factor template name. Trial accounts typically use OTP1.
# TWOFACTOR_OTP_TEMPLATE=OTP1

# Optional. Numeric country prefix prepended to the 10-digit Indian mobile.
# Leave unset unless 2Factor requires 91.
# TWOFACTOR_PHONE_PREFIX=

# Local profile defaults to console OTP (dev). Use twofactor to send real SMS locally.
# ACOMI_OTP_SENDER=dev
