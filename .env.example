# Local-only example. Copy to .env if your tooling loads it, or export in the shell.
# .env is gitignored. Never put a real production secret in this file.

# Required when ACOMI_OTP_SENDER=twofactor (production profile always uses twofactor).
TWOFACTOR_API_KEY=<your-production-api-key>

# Optional. 2Factor template name. Trial accounts typically use OTP1.
# TWOFACTOR_OTP_TEMPLATE=OTP1

# Optional. Numeric country prefix prepended to the 10-digit Indian mobile.
# Leave unset unless 2Factor requires 91.
# TWOFACTOR_PHONE_PREFIX=

# Local profile defaults to console OTP (dev). Use twofactor to send real SMS locally.
# ACOMI_OTP_SENDER=dev

# Local profile defaults acomi.mail.enabled=true. Set false to log-only (SKIPPED).
# GoDaddy Professional Email (Titan) uses smtpout.secureserver.net, not smtp.titan.email.
# ACOMI_MAIL_ENABLED=true
# SPRING_MAIL_HOST=smtpout.secureserver.net
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=support@acomi.in
# SPRING_MAIL_PASSWORD=<mailbox-password>
# ACOMI_MAIL_FROM=support@acomi.in
# ACOMI_MAIL_SUPPORT_ADDRESS=support@acomi.in

# Firebase Cloud Messaging. Never commit the service-account JSON.
# ACOMI_PUSH_ENABLED=false
# FIREBASE_CREDENTIALS_JSON=
# FIREBASE_CREDENTIALS_PATH=

# Object storage (Cloudflare R2 / MinIO / AWS S3). Local tests use in-memory by default.
# ACOMI_STORAGE_ENABLED=true
# ACOMI_STORAGE_PROVIDER=memory
# ACOMI_STORAGE_LOGICAL_NAME=memory
# ACOMI_STORAGE_BUCKET=acomi-files
# For R2 or another S3-compatible provider:
# ACOMI_STORAGE_PROVIDER=s3compatible
# ACOMI_STORAGE_LOGICAL_NAME=r2
# ACOMI_STORAGE_BUCKET=your-bucket
# ACOMI_STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# ACOMI_STORAGE_REGION=auto
# ACOMI_STORAGE_PATH_STYLE=true
# ACOMI_STORAGE_ACCESS_KEY=
# ACOMI_STORAGE_SECRET_KEY=
# ACOMI_STORAGE_UPLOAD_TTL=900
# ACOMI_STORAGE_DOWNLOAD_TTL=120
# ACOMI_STORAGE_PENDING_TTL=900
# ACOMI_STORAGE_UNASSOCIATED_GRACE_DAYS=7
# ACOMI_STORAGE_PURGE_DAYS=30
# Browser direct PUT to R2 also needs bucket CORS for the web origin (mobile RN does not).
# Allowed methods: PUT, GET, HEAD. Allowed headers: Content-Type, Content-Length.

